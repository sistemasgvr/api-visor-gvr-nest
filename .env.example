# Timezone Perú (UTC-5)
TZ=America/Lima

# Database Configuration - Supabase PostgreSQL
# Opción 1: Usar DATABASE_URL (recomendado para Supabase)
DATABASE_URL=postgresql://postgres:password@host:port/database

# Opción 2: Usar variables individuales (si no usas DATABASE_URL, descomenta estas líneas)
# DB_HOST=db.ybxqfcyultvzghccegjv.supabase.co
# DB_PORT=6543
# DB_USERNAME=postgres
# DB_PASSWORD=your-password
# DB_DATABASE=postgres

# Application Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=4001

# Database Options
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Frontend URLs (comma-separated). Se aceptan variantes con/sin www automáticamente.
FRONTEND_URLS=http://localhost:5173,http://localhost:3000,https://gestion.proyectosgvr.com,https://www.gestion.proyectosgvr.com

# DOCS: tamaño máximo multipart (MB). Por defecto 5120 (5 GB).
# UPLOAD_MAX_FILE_SIZE_MB=5120

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d

# Collabora Online Configuration
COLLABORA_URL=https://your-collabora-server.com

# Backend public URL (para callbacks y descargas)
BACKEND_PUBLIC_URL=https://your-backend-url.com

# --- MinIO / S3 (subida de archivos; opcional) ---
# Puedes usar el bloque “tipo EasyPanel” (abajo) O las variables MINIO_ENDPOINT / MINIO_ACCESS_KEY / MINIO_SECRET_KEY.
#
# URL del API S3 (mismo host que sirve S3; si solo tienes una URL pública, suele ser esta).
MINIO_SERVER_URL=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Nombre del bucket donde se guardan los archivos (elige uno; el API intentará crearlo si no existe).
MINIO_BUCKET=sistemas-gvr
#
# Alternativa equivalente (si prefieres nombres “SDK”):
# MINIO_ENDPOINT=   (misma URL que MINIO_SERVER_URL)
# MINIO_ACCESS_KEY= (mismo valor que MINIO_ROOT_USER)
# MINIO_SECRET_KEY= (mismo valor que MINIO_ROOT_PASSWORD)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Región exigida por el SDK; en MinIO suele usarse us-east-1
MINIO_REGION=us-east-1
# Path-style recomendado para MinIO (true / false)
MINIO_FORCE_PATH_STYLE=true
# URL pública opcional para enlaces guardados en BD (sin barra final). Si vacío: MINIO_ENDPOINT + bucket + clave
MINIO_PUBLIC_BASE_URL=

# Cron jobs (key para autorizar GET /acc/cron/refresh-tokens y /control-operativo/cron/cierre-jornadas)
# Genera un valor aleatorio largo y úsalo en la URL: ?key=TU_CRON_SECRET
CRON_SECRET=your-cron-secret-change-in-production

# Autodesk ACC Configuration
AUTODESK_CLIENT_ID=your-autodesk-client-id
AUTODESK_CLIENT_SECRET=your-autodesk-client-secret
AUTODESK_CALLBACK_URL=http://localhost:4001/api/acc/oauth/callback

# --- Correo (Nodemailer / SMTP; SendGrid, Amazon SES y Mailgun suelen ofrecer SMTP) ---
# false = no envía (solo log skipped); true o ausente = intenta enviar si hay MAIL_SMTP_HOST
MAIL_ENABLED=false
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
# true típico en puerto 465; false en 587 (STARTTLS)
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM_ADDRESS=no-reply@tudominio.com
MAIL_FROM_NAME=Visor GVR

# Cola BullMQ (MAIL_USE_QUEUE=true requiere REDIS_HOST)
MAIL_USE_QUEUE=false
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

