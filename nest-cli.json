{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "infrastructure/pdf/html/templates/**/*.html",
        "watchAssets": true
      },
      {
        "include": "infrastructure/mail/templates/**/*.hbs",
        "watchAssets": true
      }
    ]
  }
}
