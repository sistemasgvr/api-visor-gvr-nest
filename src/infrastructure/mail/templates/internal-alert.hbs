<p><strong>Alerta interna</strong>{{#if title}} — {{title}}{{/if}}</p>
{{#if summary}}
<p>{{summary}}</p>
{{/if}}
{{#if details}}
<pre style="white-space:pre-wrap;font-size:13px;background:#f3f4f6;padding:12px;border-radius:6px;">{{details}}</pre>
{{/if}}
{{#if source}}
<p style="font-size:12px;color:#6b7280;">Origen: {{source}}</p>
{{/if}}
